//@version=5
strategy("OTE + PD Array Strategy (Auto)", shorttitle="OTE Pro Strat", overlay=true, initial_capital=10000, pyramiding=0, margin_long=100, margin_short=100, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════
GRP1 = "Structure"
swingLen  = input.int(8, "Swing length (bars each side of pivot)", minval=2, maxval=30, group=GRP1)
minLegATR = input.float(2.5, "Min leg size (x ATR)", minval=0.5, step=0.5, group=GRP1)
maxAge    = input.int(120, "Cancel setup if not tapped after (bars)", minval=10, group=GRP1)

GRP2 = "Trade plan"
entryMode = input.string("Limit @ 0.705", "Entry mode", options=["Limit @ 0.705", "Confirmation close"], group=GRP2)
slMode    = input.string("Swing origin (1.0)", "Stop loss placement", options=["Swing origin (1.0)", "Beyond 0.786"], group=GRP2)
slBuf     = input.float(0.2, "SL buffer (x ATR)", minval=0.0, step=0.1, group=GRP2)
tp2Ext    = input.float(-0.27, "TP2 level (-0.27 or -0.62 extension)", step=0.05, group=GRP2)

GRP3 = "PD array confluence"
minScore  = input.int(1, "Min confluence needed (0-3 array types)", minval=0, maxval=3, group=GRP3)
useFVG    = input.bool(true, "Use Fair Value Gaps", group=GRP3)
useOB     = input.bool(true, "Use Order Blocks", group=GRP3)
useRB     = input.bool(true, "Use Rejection Blocks", group=GRP3)
fvgMinATR = input.float(0.1, "Min FVG size (x ATR)", minval=0.0, step=0.05, group=GRP3)
dispATR   = input.float(1.0, "OB displacement candle body (x ATR)", minval=0.2, step=0.1, group=GRP3)
rbWick    = input.float(0.5, "RB wick as % of candle range", minval=0.3, maxval=0.9, step=0.05, group=GRP3)
rbMinATR  = input.float(0.8, "RB min candle range (x ATR)", minval=0.2, step=0.1, group=GRP3)
rbLook    = input.int(8, "RB must be lowest/highest of last N bars", minval=3, group=GRP3)

GRP4 = "Display"
showPD    = input.bool(true, "Draw PD array boxes", group=GRP4)
maxZones  = input.int(30, "Max PD arrays tracked", minval=5, maxval=100, group=GRP4)
showTable = input.bool(true, "Show info table", group=GRP4)

GRP5 = "Auto trading"
allowLong  = input.bool(true, "Allow longs", group=GRP5)
allowShort = input.bool(true, "Allow shorts", group=GRP5)
riskUSD    = input.float(200.0, "Risk per trade (USD $)", minval=1.0, step=10.0, group=GRP5)
useBE      = input.bool(true, "Move SL to break-even at half the R:R", group=GRP5)
beFrac     = input.float(0.5, "Break-even trigger (0.5 = halfway to TP2)", minval=0.1, maxval=0.95, step=0.05, group=GRP5)

GRP6 = "Trading hours"
useHours    = input.bool(true, "Use trading hours rules", group=GRP6)
hoursTz     = input.string("America/New_York", "Timezone", group=GRP6)
flatHour    = input.int(16, "Close all positions at (hour, 24h)", minval=0, maxval=23, group=GRP6)
flatMinute  = input.int(45, "Close all positions at (minute)", minval=0, maxval=59, group=GRP6)
startHour   = input.int(18, "Trading resumes at (hour, 24h)", minval=0, maxval=23, group=GRP6)
startMinute = input.int(0, "Trading resumes at (minute)", minval=0, maxval=59, group=GRP6)
weekendFlat = input.bool(true, "Stay flat from Friday close time until Sunday start time", group=GRP6)

GRP7 = "Sleep window (no trading)"
useSleep         = input.bool(true, "Use sleep window", group=GRP7)
sleepStartHour   = input.int(23, "No trading from (hour, 24h)", minval=0, maxval=23, group=GRP7)
sleepStartMinute = input.int(0, "No trading from (minute)", minval=0, maxval=59, group=GRP7)
sleepEndHour     = input.int(8, "Trading allowed again at (hour, 24h)", minval=0, maxval=23, group=GRP7)
sleepEndMinute   = input.int(0, "Trading allowed again at (minute)", minval=0, maxval=59, group=GRP7)
sleepFlat        = input.bool(true, "Also close open positions when the sleep window starts", group=GRP7)

GRP8 = "Notifications"
notifyPlace = input.bool(true, "Send a notification when an order is placed", group=GRP8)
notifyBE    = input.bool(true, "Send a notification when SL moves to break-even", group=GRP8)

GRP9 = "Position limits"
minStopPct  = input.float(0.15, "Min stop distance for sizing (% of price)", minval=0.0, step=0.05, group=GRP9, tooltip="If the real stop is closer than this, the position is sized as if the stop were this far away. You then risk less than the USD amount instead of taking a huge position.")
maxNotional = input.float(10000.0, "Max position value (USD)", minval=1.0, step=500.0, group=GRP9, tooltip="Hard cap on entry price x quantity, in USD.")

// ALPHA TERMINAL webhook alerts (sent by TradingView the moment an order fills).
// Each message is a JSON fragment built from Pine values. The TradingView alert message wraps it and adds
// the secret; {{strategy.order.alert_message}} is the only placeholder TradingView fills in:
//   {"secret":"<WEBHOOK_SECRET>",{{strategy.order.alert_message}}}
// No secret is stored in this script. The id and timestamp are the UTC time the order was placed or updated.
hookMsg(string action, string qtyField) =>
    string ts = str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    "\"id\":\"OTE-" + syminfo.ticker + "-" + timeframe.period + "-" + ts + "-" + action + "\"," +
     "\"symbol\":\"" + syminfo.ticker + "\",\"timeframe\":\"" + timeframe.period + "\",\"action\":\"" + action + "\"," +
     "\"strategy\":\"OTE Pro Strat\"" + qtyField + ",\"timestamp\":\"" + ts + "\""

// Every exit (TP2, stop, break-even stop, time exit) closes the whole position: CLOSE.
string tpMsg   = hookMsg("CLOSE", "")
string slMsg   = hookMsg("CLOSE", "")
string timeMsg = hookMsg("CLOSE", "")

// ═══════════════════════════════════════════════════════════════
//  TYPES & STATE
// ═══════════════════════════════════════════════════════════════
type Zone
    float top
    float bot
    int   idx
    int   kind   // 1 = FVG, 2 = OB, 3 = RB
    int   side   // 1 = bullish, -1 = bearish
    box   bx

var array<Zone>  zones     = array.new<Zone>()
var array<line>  fibLines  = array.new<line>()
var array<label> fibLabels = array.new<label>()
var array<box>   fibBoxes  = array.new<box>()

var int   dir         = 0      // 1 = long setup, -1 = short setup, 0 = none
var float legStart    = na
var float legEnd      = na
var int   legStartBar = na
var int   legEndBar   = na
var float lastHigh    = na
var float lastLow     = na
var int   lastHighBar = na
var int   lastLowBar  = na
var bool  armed       = false
var bool  triggered   = false
var int   trigBar     = na
var float entryP      = na
var float slP         = na
var float tp2P        = na
var float beLevel     = na
var bool  beDone      = false
var bool  orderLive   = false
var float lastLimit   = na
var int   tradeScore  = 0
var string tradeTags  = ""
var box   riskBox     = na
var box   rewBox      = na
var int   nTrades     = 0
var int   nTP2        = 0
var int   nBE         = 0
var float sumRR       = 0.0
var float tradeRR     = na
var bool  forced      = false
var int   lastClosed  = 0
var float planSL      = na
var float planTP2     = na
var int   planScore   = 0
var string planTags   = ""

// ═══════════════════════════════════════════════════════════════
//  FUNCTIONS
// ═══════════════════════════════════════════════════════════════
// Fib level price. 0 = swing extreme, 1 = swing origin. Negative = extension.
lvl(float r) =>
    legEnd + (legStart - legEnd) * r

clearFib() =>
    while array.size(fibLines) > 0
        line.delete(array.pop(fibLines))
    while array.size(fibLabels) > 0
        label.delete(array.pop(fibLabels))
    while array.size(fibBoxes) > 0
        box.delete(array.pop(fibBoxes))
    true

drawFib() =>
    clearFib()
    ratios = array.from(0.0, 0.5, 0.618, 0.705, 0.786, 1.0)
    for i = 0 to array.size(ratios) - 1
        float r = array.get(ratios, i)
        float p = lvl(r)
        bool isOte = i >= 2 and i <= 4
        color c = isOte ? color.new(color.orange, 0) : color.new(color.gray, 20)
        line ln = line.new(legEndBar, p, bar_index, p, extend=extend.right, color=c, style=(i == 3 ? line.style_solid : line.style_dashed), width=(i == 3 ? 2 : 1))
        array.push(fibLines, ln)
        label lb = label.new(bar_index + 2, p, str.tostring(r) + "  " + str.tostring(p, format.mintick), style=label.style_none, textcolor=c, size=size.small)
        array.push(fibLabels, lb)
    float zHi = math.max(lvl(0.618), lvl(0.786))
    float zLo = math.min(lvl(0.618), lvl(0.786))
    box zb = box.new(legEndBar, zHi, bar_index, zLo, border_color=na, bgcolor=color.new(color.orange, 85), extend=extend.right)
    array.push(fibBoxes, zb)
    true

addZone(float zTop, float zBot, int leftBar, int kind, int side) =>
    box bx = na
    if showPD
        color c = kind == 1 ? (side == 1 ? color.new(color.teal, 80) : color.new(color.maroon, 80)) : kind == 2 ? (side == 1 ? color.new(color.blue, 80) : color.new(color.purple, 80)) : (side == 1 ? color.new(color.lime, 80) : color.new(color.yellow, 80))
        bx := box.new(leftBar, zTop, bar_index, zBot, border_color=na, bgcolor=c, extend=extend.right)
    array.push(zones, Zone.new(zTop, zBot, bar_index, kind, side, bx))
    if array.size(zones) > maxZones
        Zone z0 = array.shift(zones)
        if not na(z0.bx)
            box.delete(z0.bx)
    true

// Which PD array types overlap the OTE zone (0.618 - 0.786)?
confluence(float zHi, float zLo, int side, int minIdx) =>
    bool f = false
    bool o = false
    bool r = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.side == side and z.idx >= minIdx and z.bot <= zHi and z.top >= zLo
                if z.kind == 1
                    f := true
                else if z.kind == 2
                    o := true
                else
                    r := true
    int sc = (f ? 1 : 0) + (o ? 1 : 0) + (r ? 1 : 0)
    [sc, f, o, r]

// Position size: risk the USD amount, but never size off a stop tighter than minStopPct
// and never exceed maxNotional (USD) of position value.
calcQty(float entryPrice, float stopPrice, float rate) =>
    float stopDist  = math.max(math.abs(entryPrice - stopPrice), entryPrice * minStopPct / 100)
    float riskQty   = stopDist > 0 ? riskUSD * rate / (stopDist * syminfo.pointvalue) : 0.0
    float capQty    = maxNotional * rate / (entryPrice * syminfo.pointvalue)
    math.max(math.min(riskQty, capQty), 0.0)

// ═══════════════════════════════════════════════════════════════
//  BASE CALCULATIONS (global scope)
// ═══════════════════════════════════════════════════════════════
float atr      = ta.atr(14)
float ph       = ta.pivothigh(high, swingLen, swingLen)
float pl       = ta.pivotlow(low, swingLen, swingLen)
float lowestL  = ta.lowest(low, rbLook)
float highestH = ta.highest(high, rbLook)
float h1 = high[1]
float l1 = low[1]
float o1 = open[1]
float c1 = close[1]
float h2 = high[2]
float l2 = low[2]
// USD -> symbol currency (USD/USDT charts are ~1) so the USD amounts size the position correctly
float usdRate = nz(request.currency_rate("USD", syminfo.currency), 1.0)

// Trading hours (based on the bar's CLOSE time, so a bar that closes at 16:45 is the last one traded)
int  cm         = hour(time_close, hoursTz) * 60 + minute(time_close, hoursTz)
int  dow        = dayofweek(time_close, hoursTz)
int  flatTotal  = flatHour * 60 + flatMinute
int  startTotal = startHour * 60 + startMinute
bool dailyBreak   = cm >= flatTotal and cm < startTotal
bool weekendBlock = dow == dayofweek.saturday or (dow == dayofweek.friday and cm >= flatTotal) or (dow == dayofweek.sunday and cm < startTotal)
bool hoursBlocked = useHours and (dailyBreak or (weekendFlat and weekendBlock))

// Sleep window (can cross midnight, e.g. 23:00 -> 08:00)
int  sleepStartTotal = sleepStartHour * 60 + sleepStartMinute
int  sleepEndTotal   = sleepEndHour * 60 + sleepEndMinute
bool inSleep = sleepStartTotal > sleepEndTotal ? (cm >= sleepStartTotal or cm < sleepEndTotal) : (cm >= sleepStartTotal and cm < sleepEndTotal)
bool sleepBlocked = useSleep and inSleep

bool blocked  = hoursBlocked or sleepBlocked
bool canTrade = not blocked

// ═══════════════════════════════════════════════════════════════
//  PD ARRAYS: mitigate old ones, detect new ones
// ═══════════════════════════════════════════════════════════════
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        bool mit = z.side == 1 ? close < z.bot : close > z.top
        if mit
            if not na(z.bx)
                box.delete(z.bx)
            array.remove(zones, i)

float body = math.abs(close - open)
float rng  = high - low
float loW  = math.min(open, close) - low
float upW  = high - math.max(open, close)

bool bullFVG = useFVG and low > h2 and (low - h2) >= atr * fvgMinATR
bool bearFVG = useFVG and high < l2 and (l2 - high) >= atr * fvgMinATR
bool bullOB  = useOB and close > open and body >= atr * dispATR and close > h1 and c1 < o1
bool bearOB  = useOB and close < open and body >= atr * dispATR and close < l1 and c1 > o1
bool bullRB  = useRB and rng >= atr * rbMinATR and loW >= rng * rbWick and low <= lowestL
bool bearRB  = useRB and rng >= atr * rbMinATR and upW >= rng * rbWick and high >= highestH

if bullFVG
    addZone(low, h2, bar_index - 2, 1, 1)
if bearFVG
    addZone(l2, high, bar_index - 2, 1, -1)
if bullOB
    addZone(h1, l1, bar_index - 1, 2, 1)
if bearOB
    addZone(h1, l1, bar_index - 1, 2, -1)
if bullRB
    addZone(math.min(open, close), low, bar_index, 3, 1)
if bearRB
    addZone(high, math.max(open, close), bar_index, 3, -1)

// ═══════════════════════════════════════════════════════════════
//  POSITION SYNC: detect fills and closed trades from the strategy
// ═══════════════════════════════════════════════════════════════
bool longSig  = false
bool shortSig = false

int  closedNow  = strategy.closedtrades
bool justClosed = closedNow > lastClosed
lastClosed := closedNow
bool inPos = strategy.position_size != 0

// Entry just filled
if inPos and not triggered and dir != 0
    triggered := true
    trigBar := bar_index
    entryP := strategy.position_avg_price
    slP := planSL
    tp2P := planTP2
    beDone := false
    beLevel := entryP + (tp2P - entryP) * beFrac
    tradeScore := planScore
    tradeTags := planTags
    if dir == 1
        longSig := true
    else
        shortSig := true

    riskBox := box.new(bar_index, math.max(entryP, slP), bar_index + 1, math.min(entryP, slP), border_color=na, bgcolor=color.new(color.red, 80))
    rewBox  := box.new(bar_index, math.max(entryP, tp2P), bar_index + 1, math.min(entryP, tp2P), border_color=na, bgcolor=color.new(color.green, 80))

    float rr2 = math.abs(tp2P - entryP) / math.abs(entryP - slP)
    tradeRR := rr2
    string txt = (dir == 1 ? "LONG" : "SHORT") + "  " + str.tostring(tradeScore) + "/3  " + tradeTags + "\n" + "Entry " + str.tostring(entryP, format.mintick) + "\n" + "SL " + str.tostring(slP, format.mintick) + "\n" + "TP2 " + str.tostring(tp2P, format.mintick) + "  (" + str.tostring(rr2, "#.##") + "R)" + "\n" + "Size " + str.tostring(math.abs(strategy.position_size), "#.####")
    label.new(bar_index, dir == 1 ? low : high, txt, style=(dir == 1 ? label.style_label_up : label.style_label_down), color=(dir == 1 ? color.new(color.green, 10) : color.new(color.red, 10)), textcolor=color.white, size=size.small)

// Trade finished (position is flat again)
if not inPos and triggered
    float exitPx = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float tol = syminfo.mintick * 2
    bool wonTP2 = not forced and (dir == 1 ? exitPx >= tp2P - tol : exitPx <= tp2P + tol)
    bool atBE   = beDone and not forced and not wonTP2 and math.abs(exitPx - entryP) <= tol
    string endTxt = forced ? "Time exit" : (wonTP2 ? "TP2 hit" : (atBE ? "Break-even" : "SL hit"))
    color endCol = forced ? color.gray : (wonTP2 ? color.green : (atBE ? color.gray : color.red))
    nTrades += 1
    sumRR += tradeRR
    if wonTP2
        nTP2 += 1
    if atBE
        nBE += 1
    box.set_right(riskBox, bar_index)
    box.set_right(rewBox, bar_index)
    label.new(bar_index, exitPx, endTxt, style=label.style_label_left, color=color.new(endCol, 20), textcolor=color.white, size=size.small)
    strategy.cancel_all()
    forced := false
    triggered := false
    dir := 0
    clearFib()
else if not inPos and justClosed and dir != 0 and not triggered
    // entered and closed inside a single bar
    strategy.cancel_all()
    forced := false
    dir := 0
    clearFib()

// ═══════════════════════════════════════════════════════════════
//  MARKET STRUCTURE: find the leg to draw the OTE on
// ═══════════════════════════════════════════════════════════════
bool legChanged = false

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLen
    if dir == 0 and not na(lastLow) and lastLowBar < lastHighBar and (lastHigh - lastLow) >= atr * minLegATR
        dir := 1
        legStart := lastLow
        legStartBar := lastLowBar
        legEnd := lastHigh
        legEndBar := lastHighBar
        triggered := false
        legChanged := true
    else if dir == 1 and not triggered and ph > legEnd
        legEnd := ph
        legEndBar := bar_index - swingLen
        legChanged := true

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLen
    if dir == 0 and not na(lastHigh) and lastHighBar < lastLowBar and (lastHigh - lastLow) >= atr * minLegATR
        dir := -1
        legStart := lastHigh
        legStartBar := lastHighBar
        legEnd := lastLow
        legEndBar := lastLowBar
        triggered := false
        legChanged := true
    else if dir == -1 and not triggered and pl < legEnd
        legEnd := pl
        legEndBar := bar_index - swingLen
        legChanged := true

if legChanged
    armed := false

// Cancel setups that broke the swing origin or got stale
if dir != 0 and not triggered
    bool broken  = dir == 1 ? low < legStart : high > legStart
    bool expired = bar_index - legEndBar > maxAge
    if broken or expired
        strategy.cancel_all()
        dir := 0
        legChanged := false
        clearFib()

if legChanged and dir != 0
    drawFib()

// ═══════════════════════════════════════════════════════════════
//  TRADE PLAN + ORDER PLACEMENT (while waiting for entry)
// ═══════════════════════════════════════════════════════════════
float pEntry = na
float pSL    = na
float pTP2   = na
float pQty   = na
int   pScore = 0
string pTags = ""

if dir != 0 and not triggered
    float l618 = lvl(0.618)
    float l705 = lvl(0.705)
    float l786 = lvl(0.786)
    float zHi  = math.max(l618, l786)
    float zLo  = math.min(l618, l786)

    [sc, hF, hO, hR] = confluence(zHi, zLo, dir, legStartBar)
    pScore := sc
    pTags := (hF ? "FVG " : "") + (hO ? "OB " : "") + (hR ? "RB" : "")

    float slBase = slMode == "Swing origin (1.0)" ? legStart : l786
    float slPlan = dir == 1 ? slBase - atr * slBuf : slBase + atr * slBuf
    float tp2v   = lvl(tp2Ext)
    pEntry := l705
    pSL    := slPlan
    pTP2   := tp2v
    planSL := slPlan
    planTP2 := tp2v
    planScore := sc
    planTags := pTags

    bool limitMode = entryMode == "Limit @ 0.705"
    bool armedNow  = armed or (dir == 1 ? low > l618 : high < l618)
    bool touched   = dir == 1 ? low <= l618 : high >= l618
    bool holds     = dir == 1 ? close >= l786 : close <= l786
    bool candleOk  = dir == 1 ? close > open : close < open
    bool priceSide = dir == 1 ? close > l705 : close < l705

    float ep = limitMode ? l705 : close
    pQty := calcQty(ep, slPlan, usdRate)
    bool timing = limitMode ? (armedNow and priceSide) : (armed and touched and holds and candleOk)
    bool valid  = dir == 1 ? (tp2v > ep and ep > slPlan) : (tp2v < ep and ep < slPlan)
    bool dirOk  = dir == 1 ? allowLong : allowShort
    bool place  = timing and valid and dirOk and sc >= minScore and canTrade

    armed := armedNow

    string eid = dir == 1 ? "OTE Long" : "OTE Short"
    if place
        float qty = pQty
        if qty > 0
            string sideWord = dir == 1 ? "LONG" : "SHORT"
            // Long entry = BUY, short entry = SELL. ALPHA TERMINAL accepts whole shares only, so the webhook
            // carries the strategy's size rounded down to a whole number (the strategy's own sizing is unchanged).
            string entryMsg = hookMsg(dir == 1 ? "BUY" : "SELL", ",\"qty\":" + str.tostring(math.floor(qty)))
            if limitMode
                strategy.entry(eid, dir == 1 ? strategy.long : strategy.short, qty=qty, limit=math.round_to_mintick(l705), alert_message=entryMsg)
            else
                strategy.entry(eid, dir == 1 ? strategy.long : strategy.short, qty=qty, alert_message=entryMsg)
            strategy.exit(eid + " TP2", eid, limit=math.round_to_mintick(tp2v), stop=math.round_to_mintick(slPlan), alert_profit=tpMsg, alert_loss=slMsg)

            // Notification: order placed (first time, or again if the entry level moved)
            bool newOrder = not orderLive or (limitMode and math.abs(l705 - lastLimit) >= syminfo.mintick)
            if notifyPlace and newOrder
                string placeHead = limitMode ? " order placed: " + (dir == 1 ? "BUY LIMIT @ " : "SELL LIMIT @ ") + str.tostring(l705, format.mintick) : " order placed (market, fills next bar)"
                string placeMsg = "OTE " + sideWord + placeHead + " on " + syminfo.ticker + " | SL " + str.tostring(slPlan, format.mintick) + " | TP2 " + str.tostring(tp2v, format.mintick) + " | Size " + str.tostring(qty, "#.####")
                alert(placeMsg, alert.freq_once_per_bar_close)
            orderLive := true
            lastLimit := l705
    else
        strategy.cancel_all()

// No order can be waiting when there is no setup or a trade is already open
if not (dir != 0 and not triggered)
    orderLive := false

// ═══════════════════════════════════════════════════════════════
//  TRADE MANAGEMENT (boxes + break-even at half the R:R)
// ═══════════════════════════════════════════════════════════════
if triggered and inPos
    box.set_right(riskBox, bar_index)
    box.set_right(rewBox, bar_index)
    if useBE and not beDone and bar_index > trigBar
        bool beHit = dir == 1 ? high >= beLevel : low <= beLevel
        if beHit
            beDone := true
            string eidT = dir == 1 ? "OTE Long" : "OTE Short"
            strategy.exit(eidT + " TP2", eidT, limit=math.round_to_mintick(tp2P), stop=math.round_to_mintick(entryP), alert_profit=tpMsg, alert_loss=slMsg)
            label.new(bar_index, beLevel, "SL to BE", style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
            if notifyBE
                alert("OTE: stop moved to break-even on " + syminfo.ticker + " @ " + str.tostring(entryP, format.mintick), alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════
//  TIME EXIT: flatten + cancel orders outside trading hours / sleep window
// ═══════════════════════════════════════════════════════════════
bool flattenNow = hoursBlocked or (sleepBlocked and sleepFlat)
if blocked
    if inPos and flattenNow
        forced := true
        strategy.cancel_all()
        strategy.close_all(comment="Time exit", alert_message=timeMsg, immediately=true)
    else if not inPos
        strategy.cancel_all()

// ═══════════════════════════════════════════════════════════════
//  SIGNALS
// ═══════════════════════════════════════════════════════════════
plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.small, text="L")
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.red,   size=size.small, text="S")

// ═══════════════════════════════════════════════════════════════
//  INFO TABLE
// ═══════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=1, border_color=color.new(color.gray, 60), border_width=1)

if barstate.islast and showTable
    bool active = dir != 0
    float dE = triggered ? entryP : pEntry
    float dS = triggered ? slP : pSL
    float d2 = triggered ? tp2P : pTP2
    float dQ = triggered ? math.abs(strategy.position_size) : pQty
    int   dSc = triggered ? tradeScore : pScore
    string dTg = triggered ? tradeTags : pTags

    string bias = not active ? "-" : dir == 1 ? "LONG (bullish leg)" : "SHORT (bearish leg)"
    string blockTxt = sleepBlocked and not hoursBlocked ? "Sleep window (no trading)" : "Outside trading hours"
    string status = blocked and not triggered ? blockTxt : not active ? "Waiting for a swing" : triggered ? (beDone ? "IN TRADE (SL at BE)" : "IN TRADE") : (orderLive ? "ORDER PLACED - waiting fill" : (pScore < minScore ? "Need more confluence" : "Waiting for OTE tap"))
    color statusCol = blocked and not triggered ? color.orange : triggered ? color.lime : (not active ? color.gray : (orderLive ? color.aqua : (pScore < minScore ? color.orange : color.white)))
    string rrTxt = (na(dE) or na(dS) or na(d2)) ? "-" : str.tostring(math.abs(d2 - dE) / math.abs(dE - dS), "#.##") + "R"
    string wr = nTrades == 0 ? "no trades yet" : "TP2 " + str.tostring(nTP2) + "/" + str.tostring(nTrades) + " (" + str.tostring(nTP2 * 100.0 / nTrades, "#.#") + "%)" + (nBE > 0 ? " | BE " + str.tostring(nBE) : "")
    string avgRR = nTrades == 0 ? "-" : str.tostring(sumRR / nTrades, "#.##") + "R"
    // Actual USD at risk and USD position value for the shown size
    float riskAtStop = (na(dE) or na(dS) or na(dQ)) ? na : math.abs(dE - dS) * dQ * syminfo.pointvalue / usdRate
    float posValue   = (na(dE) or na(dQ)) ? na : dE * dQ * syminfo.pointvalue / usdRate
    string sizeTxt   = na(dQ) ? "-" : str.tostring(dQ, "#.####") + "  (~$" + str.tostring(posValue, "#,###") + ")"
    string riskTxt   = na(riskAtStop) ? "-" : "$" + str.tostring(riskAtStop, "#,###.##") + " of $" + str.tostring(riskUSD, "#,###")

    table.cell(info, 0, 0, "OTE + PD ARRAYS", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 40))
    table.merge_cells(info, 0, 0, 1, 0)
    table.cell(info, 0, 1, "Bias", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 1, bias, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 2, "Status", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 2, status, text_color=statusCol, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 3, "Entry", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 3, na(dE) ? "-" : str.tostring(dE, format.mintick), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 4, "Stop loss", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 4, na(dS) ? "-" : str.tostring(dS, format.mintick), text_color=color.red, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 5, "TP2", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 5, na(d2) ? "-" : str.tostring(d2, format.mintick), text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 6, "R:R to TP2", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 6, rrTxt, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 7, "Confluence", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 7, active ? str.tostring(dSc) + "/3  " + dTg : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 8, "Size", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 8, active ? sizeTxt : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 9, "Risk at stop", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 9, active ? riskTxt : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 10, "Win rate", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 10, wr, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 11, "Avg R:R to TP2", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(info, 1, 11, avgRR, text_color=color.white, text_size=size.small, text_halign=text.align_left)
