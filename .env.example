# ALPHA TERMINAL — server-side environment. PAPER ONLY.
# Copy to .env for local development. NEVER commit .env. Never put these in the frontend.

# Alpaca PAPER API keys (https://app.alpaca.markets → Paper account → API Keys)
ALPACA_KEY=replace-with-paper-key-id
ALPACA_SECRET=replace-with-paper-secret

# Shared secret TradingView puts in each alert body. Long random string.
WEBHOOK_SECRET=replace-with-long-random-string
# Dashboard sign-in passphrase (also usable as a Bearer token for scripts). Long random string.
ADMIN_SECRET=replace-with-long-random-passphrase

# Master switch for submitting PAPER orders. Engine cannot START while false.
ENABLE_TRADING=false

# Optional. Default: SQLite file at backend/data/alpha_terminal.db
# DATABASE_URL=sqlite:////data/alpha_terminal.db

# Risk limits
ALLOWED_SYMBOLS=SPY,QQQ,AAPL,NVDA
MAX_ORDER_QTY=10
MAX_ORDER_NOTIONAL=5000
MAX_POSITION_EXPOSURE=10000
MAX_TOTAL_EXPOSURE=25000
MAX_OPEN_POSITIONS=5
SHORT_SELLING_ENABLED=false
ALLOW_FRACTIONAL_QTY=false
# 0 disables. Blocks new exposure once today's PAPER P&L <= -limit.
DAILY_LOSS_LIMIT=2000
# Optional fixed baseline for return %. If unset, equity at first connection is used.
# PAPER_STARTING_EQUITY=100000

# Web
FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000
# Must be true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false
SESSION_HOURS=12
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
# true only behind a proxy that sets CF-Connecting-IP / Fly-Client-IP (Fly.io, Cloudflare)
TRUST_PROXY_HEADERS=false
# Optional: TradingView's published sender IPs, comma separated
# TRADINGVIEW_IP_ALLOWLIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
ENABLE_API_DOCS=false
BROKER_TIMEOUT_SECONDS=2.5
ORDER_SYNC_INTERVAL_SECONDS=15
MARKET_DATA_MAX_AGE_SECONDS=900
