# ALPHA TERMINAL OTE engine — copy to engine/.env (git-ignored) or point ENGINE_ENV_FILE at a file outside the repo.
# PAPER only: the engine never contacts a broker. There is no live-trading setting.

ENGINE_SYMBOL=SOLUSD            # only SOLUSD is enabled so far
ENGINE_INTERVAL_MIN=5
ENGINE_DATA_DIR=data            # state, lock file; keep it on persistent disk
ENGINE_POLL_SECONDS=20
ENGINE_LATE_BARS=2              # fills from candles older than this are recorded, not sent

# Sync to ALPHA TERMINAL (off = local only). Use a development Worker first, e.g. http://127.0.0.1:8787 (wrangler dev).
ENGINE_SYNC=off
ALPHA_API_BASE=
ALPHA_WEBHOOK_SECRET=           # the Worker's WEBHOOK_SECRET; never commit it

# Strategy inputs: Pine defaults unless set here (STRAT_ + input name in UPPER_SNAKE_CASE), e.g.
# STRAT_RISK_USD=20
# STRAT_ALLOW_SHORT=false
