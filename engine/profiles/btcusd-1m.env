# ALPHA-03 · KRAKEN:BTCUSD 1m — the owner's TradingView inputs (screenshots supplied 2026-11-12), version 1.
# Immutable: a change is a NEW profile file/version with the owner's approval (docs/MULTI-BOT-ARCHITECTURE.md §4).
# Entry mode and stop placement: truncated labels ("Limit @ ...", "Swing o...") match only "Limit @ 0.705" and
# "Swing origin (1.0)" among the Pine options. Notification toggles (order placement, break-even, trailing) are ON in
# the screenshot; they are display/alert settings and do not affect trading.
# Structure
STRAT_SWING_LEN=12
STRAT_MIN_LEG_ATR=5
STRAT_MAX_AGE=85
# Trade plan
STRAT_ENTRY_MODE=Limit @ 0.705
STRAT_SL_MODE=Swing origin (1.0)
STRAT_SL_BUF=0.2
STRAT_TP2_EXT=-0.55
# PD arrays
STRAT_MIN_SCORE=1
STRAT_USE_FVG=true
STRAT_FVG_MIN_ATR=0.1
STRAT_USE_OB=true
STRAT_DISP_ATR=1
STRAT_USE_RB=true
STRAT_RB_WICK=0.5
STRAT_RB_MIN_ATR=0.8
STRAT_RB_LOOK=8
STRAT_MAX_ZONES=70
# Trading (reference Pine risk; the funded bot's own dollar risk is a separate, owner-edited setting)
STRAT_ALLOW_LONG=true
STRAT_ALLOW_SHORT=true
STRAT_RISK_USD=10
STRAT_USE_BE=true
STRAT_BE_FRAC=0.35
STRAT_USE_TRAIL=true
STRAT_TRAIL_FRAC=0.2
STRAT_TRAIL_LEN=4
STRAT_TRAIL_BUF=0.25
# Sessions: off (24/7). Recorded inactive values: close 16:45, resume 18:00, sleep 23:00-08:00, America/New_York.
STRAT_USE_HOURS=false
STRAT_WEEKEND_FLAT=false
STRAT_USE_SLEEP=false
STRAT_HOURS_TZ=America/New_York
