# The user's SOLUSD 5-minute strategy settings (ENGINE_PROFILE=solusd-5m), copied from their TradingView inputs
# for KRAKEN:SOLUSD 5m (chart time zone UTC). Everything not listed keeps the Pine default; the Pine defaults and
# the paper-test profile are unchanged.
#
# Structure
STRAT_SWING_LEN=5
STRAT_MIN_LEG_ATR=3.5
STRAT_MAX_AGE=32
# Trade plan
STRAT_ENTRY_MODE=Limit @ 0.705
STRAT_SL_MODE=Swing origin (1.0)
STRAT_SL_BUF=0.1
STRAT_TP2_EXT=0.25
# PD arrays
STRAT_MIN_SCORE=1
STRAT_USE_FVG=true
STRAT_FVG_MIN_ATR=0.1
STRAT_USE_OB=true
STRAT_DISP_ATR=1
STRAT_USE_RB=true
STRAT_RB_WICK=0.5
STRAT_RB_MIN_ATR=0.8
STRAT_RB_LOOK=8
STRAT_MAX_ZONES=70
# Trading. Risk per trade starts at $10; the ALPHA TERMINAL website can apply a different value later (the engine
# then uses the confirmed website setting for new entries only).
STRAT_ALLOW_LONG=true
STRAT_ALLOW_SHORT=true
STRAT_RISK_USD=10
STRAT_USE_BE=true
STRAT_BE_FRAC=0.45
STRAT_USE_TRAIL=true
STRAT_TRAIL_FRAC=0.05
STRAT_TRAIL_LEN=3
STRAT_TRAIL_BUF=0.05
# Sessions: hours, weekend and sleep restrictions off. The other time inputs keep their Pine defaults (inactive).
STRAT_USE_HOURS=false
STRAT_WEEKEND_FLAT=false
STRAT_USE_SLEEP=false
STRAT_HOURS_TZ=America/New_York
# Use the risk per trade applied on the ALPHA TERMINAL website (new entries only; confirmed back to the website).
ENGINE_REMOTE_SETTINGS=on
