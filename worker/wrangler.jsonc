{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpha-terminal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",

  // The dashboard (frontend/dist) is served by this same Worker, so the
  // browser and API share one origin: the session cookie stays
  // SameSite=Strict, host-only and HttpOnly, and no CORS is needed.
  // Build the frontend first: npm --prefix ../frontend run build
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/webhook",
      "/webhook/*",
      "/health",
      "/engine/*",
      "/kill",
      "/kill/*"
    ]
  },

  "vars": {
    "ENABLE_TRADING": "false",
    "ALLOWED_SYMBOLS": "MES,MNQ,GOLD,BTCUSD,ETHUSD,SOLUSD,HYPEUSD,KAITOUSD",
    "MAX_ORDER_QTY": "10",
    "MAX_ORDER_NOTIONAL": "5000",
    "MAX_FUTURES_ORDER_NOTIONAL": "75000",
    "MAX_POSITION_EXPOSURE": "10000",
    "MAX_TOTAL_EXPOSURE": "25000",
    "MAX_OPEN_POSITIONS": "5",
    "SHORT_SELLING_ENABLED": "false",
    "DAILY_LOSS_LIMIT": "2000",
    // Simulated execution costs on ALPHA PAPER fills (src/costs.ts): none | ndax | kraken_pro_t1.
    // "none" until the owner separately approves a cost profile: a plain `wrangler deploy` must never switch on fees.
    // Activating one is a deliberate change of this value (docs/RELEASE-RUNBOOK.md section 5).
    "PAPER_COST_PROFILE": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-terminal-db",
      "database_id": "40741873-0a98-4b23-b4e2-19ac8acec80c",
      "migrations_dir": "migrations"
    }
  ]
}